{
  "version": 2,
  "installCommand": "corepack pnpm install --no-optional --frozen-lockfile",
  "rewrites": [{ "source": "/ready", "destination": "/api/ready" }],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "excludeFiles": "{**/onnxruntime-node/**,**/sharp/**,**/libonnxruntime*.so}"
    }
  }
}
