{
  "name": "generic-curriculum-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:public": "vitest run tests/unit/hyoja-ui-foundation.test.tsx tests/unit/hyoja-school-adapter.test.ts tests/unit/hyoja-subject-catalog.test.ts tests/unit/hyoja-runtime-routing.test.tsx tests/unit/hyoja-public-layout.test.tsx tests/unit/hyoja-home-page.test.tsx tests/unit/hyoja-recommend-page.test.tsx tests/unit/hyoja-roadmap-page.test.tsx tests/unit/hyoja-subjects-page.test.tsx tests/unit/public-student-page.test.tsx tests/unit/protected-curriculum-routes.test.ts tests/unit/publish-public-handoff.test.tsx",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:hyoja": "playwright test --project=chrome tests/e2e/hyoja-public-flow.spec.ts tests/e2e/hyoja-upload-publish.spec.ts",
    "typecheck": "prisma generate && tsc --noEmit --pretty false",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.9.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.2.0",
    "pglite-server": "^0.1.5",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.14"
  }
}
